# ClubOps AI - Environment Configuration Example

# Application Settings
PROJECT_NAME="ClubOps AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & JWT
JWT_SECRET="generate-a-strong-32-byte-hex-key-here-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL default, SQLite fallback supported for development)
# Example PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/clubops_db
DATABASE_URL="sqlite:///./clubops.db"

# AI Integration
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Notifications (Brevo Email API)
BREVO_API_KEY="your-brevo-api-key-here"
EMAIL_FROM="noreply@clubops.ai"
EMAIL_FROM_NAME="ClubOps AI"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:5173"
